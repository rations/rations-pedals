# Local-only agent guidance (not published; comments in tracked files must not
# reference these)
CLAUDE.md
RULES.md
task.md
PLAN.md
.claude/

# Personal CMake configure presets (local reference-tree paths).
CMakeUserPresets.json

# Build directories
build/
build-*/
cmake-build-*/

# CMake generated
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt
# ...but cmake/ holds SOURCE scripts, not generated ones — the MinGW toolchain
# file lives there and is named on the configure command line, so without this
# negation the blanket *.cmake above would keep it out of a fresh clone and the
# Windows build would be unreproducible. Generated .cmake files all live under
# the build directories already ignored above.
!cmake/*.cmake

# Compiled output
*.o
*.a
*.so
*.so.*
*.vst3

# Release archives produced by scripts/makedist-*.sh — these are attached to
# releases, not committed.
dist/
*.tar.gz
*.tar.xz
*.zip

# The untrimmed art exports that gui/ reads. What ships is the trimmed PNG beside
# them; the *-base.png sources are large and are regenerated, not edited.
resources/img/*-base.png

# Debug info
*.pdb
*.dSYM/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.clangd/
compile_commands.json

# OS
.DS_Store
Thumbs.db
